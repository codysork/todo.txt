#!/usr/bin/env bash
#
# @file pace (todo.sh action)
# @author Cody Sork <codysork@gmail.com> with help from ChatGPT
# @created 2026-11-04
# @modified 2026-11-23
# @description Calculate physical, mental, and stress effort velocity.
#
# Usage:
#   todo.sh pace [daily|weekly|monthly|annual] [count]

# AI-generated code (unreviewed by a human)
set -euo pipefail

#----------------------------------------------------------------------------
# Configuration
#----------------------------------------------------------------------------

# AI-generated code (unreviewed by a human)
DONE_FILE="${DONE_FILE:-${TODO_DIR:-$HOME}/done.txt}"
TODAY=$(date +%Y-%m-%d)

#----------------------------------------------------------------------------
# Functions
#----------------------------------------------------------------------------

# AI-generated code (unreviewed by a human)
usage() {
    echo "Usage: todo.sh pace [daily|weekly|monthly|annual] [count]"
}

# AI-generated code (unreviewed by a human)
# Sum a score field completed within a date range.
# AI-generated code (unreviewed by a human)
sum_points() {
    local field="$1"
    local start="$2"
    local end="$3"

    awk -v field="$field" -v start="$start" -v end="$end" '
        $1 == "x" && $2 >= start && $2 <= end {
            for (i = 3; i <= NF; i++) {
                if ($i ~ ("^" field ":[0-9]+([.][0-9]+)?$")) {
                    sum += substr($i, length(field) + 2)
                    break
                }
            }
        }
        END {
            printf "%.2f", sum
        }
    ' "$DONE_FILE"
}

# Calculate inclusive calendar days between two dates.
# AI-generated code (unreviewed by a human)
days_between() {
    local start="$1"
    local end="$2"

    echo $(( (
        $(date -d "$end" +%s) -
        $(date -d "$start" +%s)
    ) / 86400 + 1 ))
}

# Print report header.
# AI-generated code (unreviewed by a human)
print_header() {
    echo
    printf '%-16s %6s %10s %12s %10s %12s %10s %12s\n' \
        "Period" "Days" "Physical" "Physical/day" \
        "Mental" "Mental/day" "Stress" "Stress/day"
    printf '%-16s %6s %10s %12s %10s %12s %10s %12s\n' \
        "----------------" "------" "----------" "------------" \
        "----------" "------------" "----------" "------------"
}

# Generate a report row.
# AI-generated code (unreviewed by a human)
report_period() {
    local label="$1"
    local start="$2"
    local end="$3"

    local days
    local physical
    local mental
    local stress
    local velocities
    local physical_per_day
    local mental_per_day
    local stress_per_day

    days=$(days_between "$start" "$end")
    physical=$(sum_points physical "$start" "$end")
    mental=$(sum_points mental "$start" "$end")
    stress=$(sum_points stress "$start" "$end")
    velocities=$(awk \
        -v physical="$physical" -v mental="$mental" \
        -v stress="$stress" -v days="$days" \
        'BEGIN { printf "%.2f %.2f %.2f", physical / days, mental / days, stress / days }')
    read -r physical_per_day mental_per_day stress_per_day <<< "$velocities"

    printf '%-16s %6s %10s %12s %10s %12s %10s %12s\n' \
        "$label" "$days" "$physical" "$physical_per_day" \
        "$mental" "$mental_per_day" "$stress" "$stress_per_day"
}

# AI-generated code (unreviewed by a human)
report_mode() {
    local index
    local start
    local end
    local label
    local day_of_week
    local current_week
    local current_month
    local next_month
    local current_year
    local next_year

    case "$MODE" in
        day|daily)
            for ((index = COUNT - 1; index >= 0; index--)); do
                start=$(date -d "$TODAY - $index days" +%Y-%m-%d)
                label=$(date -d "$start" '+%Y-%m-%d')
                report_period "$label" "$start" "$start"
            done
            ;;

        week|weekly)
            day_of_week=$(date -d "$TODAY" +%u)
            current_week=$(date -d "$TODAY - $((day_of_week - 1)) days" +%Y-%m-%d)

            for ((index = COUNT - 1; index >= 0; index--)); do
                start=$(date -d "$current_week - $index weeks" +%Y-%m-%d)
                end=$(date -d "$start + 6 days" +%Y-%m-%d)
                if [[ "$end" > "$TODAY" ]]; then
                    end=$TODAY
                fi
                label=$(date -d "$start" '+%G-W%V')
                report_period "$label" "$start" "$end"
            done
            ;;

        month|monthly)
            current_month=$(date -d "$TODAY" +%Y-%m-01)
            for ((index = COUNT - 1; index >= 0; index--)); do
                start=$(date -d "$current_month - $index months" +%Y-%m-%d)
                next_month=$(date -d "$start + 1 month" +%Y-%m-%d)
                end=$(date -d "$next_month - 1 day" +%Y-%m-%d)
                if [[ "$end" > "$TODAY" ]]; then
                    end=$TODAY
                fi
                label=$(date -d "$start" '+%b %Y')
                report_period "$label" "$start" "$end"
            done
            ;;

        annual|year|yearly)
            current_year=$(date -d "$TODAY" +%Y-01-01)
            for ((index = COUNT - 1; index >= 0; index--)); do
                start=$(date -d "$current_year - $index years" +%Y-%m-%d)
                next_year=$(date -d "$start + 1 year" +%Y-%m-%d)
                end=$(date -d "$next_year - 1 day" +%Y-%m-%d)
                if [[ "$end" > "$TODAY" ]]; then
                    end=$TODAY
                fi
                label=$(date -d "$start" '+%Y')
                report_period "$label" "$start" "$end"
            done
            ;;
    esac
}

#----------------------------------------------------------------------------
# Main
#----------------------------------------------------------------------------

# AI-generated code (unreviewed by a human)
# Validate arguments.
MODE="${2:-monthly}"
COUNT="${3:-}"

case "$MODE" in
    day|daily|week|weekly|month|monthly|annual|year|yearly)
        ;;
    -h|--help|help)
        usage
        exit 0
        ;;
    *)
        echo "Error: Invalid pace mode '$MODE'." >&2
        usage >&2
        exit 1
        ;;
esac

# Set default period count.
if [[ -z "$COUNT" ]]; then
    case "$MODE" in
        daily)          COUNT=30 ;;
        weekly)         COUNT=52 ;;
        monthly)        COUNT=12 ;;
        annual|yearly)  COUNT=10 ;;
    esac
fi

# Validate period count.
if [[ ! "$COUNT" =~ ^[0-9]+$ ]] || (( 10#$COUNT == 0 )); then
    echo "Error: Count must be a positive integer." >&2
    usage >&2
    exit 1
fi

COUNT=$((10#$COUNT))

# Dependencies.
for cmd in date awk; do
    command -v "$cmd" >/dev/null 2>&1 || {
        echo "Error: Required command '$cmd' not found." >&2
        exit 1
    }
done

# Validate done.txt.
if [[ ! -f "$DONE_FILE" || ! -r "$DONE_FILE" ]]; then
    echo "Error: Cannot read done file: $DONE_FILE" >&2
    exit 1
fi

# AI-generated code (unreviewed by a human)
print_header
report_mode

echo

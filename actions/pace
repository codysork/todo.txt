#!/usr/bin/env bash
#
# @file pace (todo.sh action)
# @author Cody Sork <codysork@gmail.com> with help from ChatGPT
# @created 2026-11-04
# @modified 2026-11-24
# @description Calculate physical, mental, and stress effort velocity.
#
# Usage:
#   todo.sh pace [daily|weekly|monthly|annual] [count]

set -euo pipefail

#----------------------------------------------------------------------------
# Configuration
#----------------------------------------------------------------------------

DONE_FILE="${DONE_FILE:-${TODO_DIR:-$HOME}/done.txt}"
TODAY=$(date +%Y-%m-%d)

#----------------------------------------------------------------------------
# Functions
#----------------------------------------------------------------------------

# AI-generated documentation (not reviewed by a human)
# @description Print the pace command's usage line.
usage() {
    echo "Usage: todo.sh pace [daily|weekly|monthly|annual] [count]"
}

# AI-generated documentation (not reviewed by a human)
# @description Sum one score field from completions in a date range.
# @param field: metadata key to sum (physical, mental, or stress).
# @param start: first completion date, inclusive.
# @param end: last completion date, inclusive.
# @return: formatted two-decimal sum printed to stdout.
sum_points() {
    local field="$1"
    local start="$2"
    local end="$3"

    awk -v field="$field" -v start="$start" -v end="$end" '
        $1 == "x" && $2 >= start && $2 <= end {
            for (i = 3; i <= NF; i++) {
                if ($i ~ ("^" field ":[0-9]+([.][0-9]+)?$")) {
                    sum += substr($i, length(field) + 2)
                    break
                }
            }
        }
        END {
            printf "%.2f", sum
        }
    ' "$DONE_FILE"
}

# AI-generated documentation (not reviewed by a human)
# @description Count calendar days between two dates, inclusive.
# @param start: first ISO date.
# @param end: last ISO date.
# @return: inclusive day count printed to stdout.
days_between() {
    local start="$1"
    local end="$2"

    echo $(( (
        $(date -d "$end" +%s) -
        $(date -d "$start" +%s)
    ) / 86400 + 1 ))
}

# AI-generated documentation (not reviewed by a human)
# @description Print the report's column headings.
print_header() {
    echo
    printf '%-16s %6s %10s %12s %10s %12s %10s %12s\n' \
        "Period" "Days" "Physical" "Physical/day" \
        "Mental" "Mental/day" "Stress" "Stress/day"
    printf '%-16s %6s %10s %12s %10s %12s %10s %12s\n' \
        "----------------" "------" "----------" "------------" \
        "----------" "------------" "----------" "------------"
}

# AI-generated documentation (not reviewed by a human)
# @description Print one report row with totals and per-day velocities.
# @param label: period label shown in the first column.
# @param start: first date of the period.
# @param end: last date of the period.
report_period() {
    local label="$1"
    local start="$2"
    local end="$3"

    local days
    local physical
    local mental
    local stress
    local velocities
    local physical_per_day
    local mental_per_day
    local stress_per_day

    days=$(days_between "$start" "$end")
    physical=$(sum_points physical "$start" "$end")
    mental=$(sum_points mental "$start" "$end")
    stress=$(sum_points stress "$start" "$end")
    velocities=$(awk \
        -v physical="$physical" -v mental="$mental" \
        -v stress="$stress" -v days="$days" \
        'BEGIN { printf "%.2f %.2f %.2f", physical / days, mental / days, stress / days }')
    read -r physical_per_day mental_per_day stress_per_day <<< "$velocities"

    printf '%-16s %6s %10s %12s %10s %12s %10s %12s\n' \
        "$label" "$days" "$physical" "$physical_per_day" \
        "$mental" "$mental_per_day" "$stress" "$stress_per_day"
}

# AI-generated documentation (not reviewed by a human)
# @description Limit a period end date to today.
# @param end: candidate end date as an ISO string.
# @return: today when end is in the future, otherwise end.
clamp_to_today() {
    local end="$1"
    if [[ "$end" > "$TODAY" ]]; then
        echo "$TODAY"
    else
        echo "$end"
    fi
}

# AI-generated documentation (not reviewed by a human)
# @description Print a range of periods for one configured mode.
# @param anchor: date from which period starts are counted backwards.
# @param step: date unit for each backward step (days, weeks, months, years).
# @param end_offset: GNU date expression for the period end, e.g. "6 days".
# @param label_format: date format used for each period label.
report_range() {
    local anchor="$1"
    local step="$2"
    local end_offset="$3"
    local label_format="$4"
    local index
    local start
    local end
    local label

    for ((index = COUNT - 1; index >= 0; index--)); do
        start=$(date -d "$anchor - $index $step" +%Y-%m-%d)
        end=$(clamp_to_today "$(date -d "$start + $end_offset" +%Y-%m-%d)")
        label=$(date -d "$start" "$label_format")
        report_period "$label" "$start" "$end"
    done
}

# AI-generated documentation (not reviewed by a human)
# @description Dispatch to the range configuration for the selected MODE.
report_mode() {
    local anchor
    local day_of_week

    case "$MODE" in
        day|daily)
            report_range "$TODAY" days "0 days" '+%Y-%m-%d'
            ;;
        week|weekly)
            day_of_week=$(date -d "$TODAY" +%u)
            anchor=$(date -d "$TODAY - $((day_of_week - 1)) days" +%Y-%m-%d)
            report_range "$anchor" weeks "6 days" '+%G-W%V'
            ;;
        month|monthly)
            anchor=$(date -d "$TODAY" +%Y-%m-01)
            report_range "$anchor" months "1 month - 1 day" '+%b %Y'
            ;;
        annual|year|yearly)
            anchor=$(date -d "$TODAY" +%Y-01-01)
            report_range "$anchor" years "1 year - 1 day" '+%Y'
            ;;
    esac
}

#----------------------------------------------------------------------------
# Main
#----------------------------------------------------------------------------

# Validate arguments.
MODE="${2:-monthly}"
COUNT="${3:-}"

case "$MODE" in
    day|daily|week|weekly|month|monthly|annual|year|yearly)
        ;;
    -h|--help|help)
        usage
        exit 0
        ;;
    *)
        echo "Error: Invalid pace mode '$MODE'." >&2
        usage >&2
        exit 1
        ;;
esac

# Set default period count.
if [[ -z "$COUNT" ]]; then
    case "$MODE" in
        daily)          COUNT=30 ;;
        weekly)         COUNT=52 ;;
        monthly)        COUNT=12 ;;
        annual|yearly)  COUNT=10 ;;
    esac
fi

# Validate period count.
if [[ ! "$COUNT" =~ ^[0-9]+$ ]] || (( 10#$COUNT == 0 )); then
    echo "Error: Count must be a positive integer." >&2
    usage >&2
    exit 1
fi

COUNT=$((10#$COUNT))

# Dependencies.
for cmd in date awk; do
    command -v "$cmd" >/dev/null 2>&1 || {
        echo "Error: Required command '$cmd' not found." >&2
        exit 1
    }
done

# Validate done.txt.
if [[ ! -f "$DONE_FILE" || ! -r "$DONE_FILE" ]]; then
    echo "Error: Cannot read done file: $DONE_FILE" >&2
    exit 1
fi

print_header
report_mode

echo

#!/bin/bash
#
# @file repeat (todo.sh action)
# @author Mark D. White (edited by Cody Sork <codysork@gmail.com> with help from ChatGPT)
# @created 2011-11-16
# @modified 2026-11-22
# @description An addon command for todo.txt-cli that marks an item done and 
#              immediately re-enters it, optionally running configured hooks.

TODO_CMD="${TODO_FULL_SH:-${TODO_SH:-todo.sh}}"
# AI-generated code (unreviewed by a human)
REPEAT_ACTION_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source "$REPEAT_ACTION_DIR/../lib/hooks.sh"

function usage {
    echo " Customized repeat:"
    echo "   repeat ITEM"
    echo "     mark an item complete then re-enter it"
    echo "   repeat ITEM [DATE|DAY]"
    echo "     mark an item complete then re-enter it, rescheduling"
    echo "     its threshold date to DATE or DAY (just like todo schedule)"
    echo ""
    exit
}

function normalize_target_date {
    local input=$1
    if [[ "$input" =~ ^[0-9]+$ ]]; then
        echo "${input} days"
    elif [[ "$input" =~ ^\+[0-9]+$ ]]; then
        echo "${input#+} days"
    else
        echo "$input"
    fi
}

function prepare_task_line {
    local line=$1
    local priority=""

    if [[ "$line" == \([A-Za-z]\)\ * ]]; then
        priority="${line:1:1}"
        priority="${priority^^}"
        line="${line:4}"
    fi

    if [[ "$line" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}\  ]]; then
        line="${line#* }"
    fi

    if [ -n "$priority" ]; then
        line="($priority) $line"
    fi

    echo "$line"
}

# AI-generated code (unreviewed by a human)
function repeat_task {
    local item=$1
    local line=$2
    local target_date=$3

    [ -z "$line" ] && return 0
    [ -n "$DO" ] && ! $DO && return 0

    if [ -n "$target_date" ]; then
        if [ "$(todo_count_hooks repeat preflight)" -eq 0 ] ||
            [ "$(todo_count_hooks repeat after_add)" -eq 0 ]; then
            echo "Error: repeat date hooks are not fully configured." >&2
            exit 1
        fi
        todo_run_hooks repeat preflight "$item" "$target_date" || exit $?
    fi

    "$TODO_CMD" command do "$item" || exit $?
    "$TODO_CMD" command add "$line" || exit $?

    local new_item
    new_item=$(sed -n '$ =' "$TODO_FILE")
    todo_run_hooks repeat after_add "$item" "$new_item" "$target_date" || exit $?
}

# AI-generated code (unreviewed by a human)
# --- Main ---

action=$1
shift

[ "$action" = "usage" ] || [ "$action" = "help" ] && usage

ITEM=$1
shift || true
PARAM="$*"

case "$ITEM" in
    usage|help|-h|--help)
        usage
        ;;
esac

if ! [[ "$ITEM" =~ ^[0-9]+$ ]]; then
    echo "Error! Usage:"
    usage
fi

LINE=$(sed "$ITEM!d" "$TODO_FILE")
if [ -z "$LINE" ]; then
    echo "TODO: No task $ITEM."
    exit 1
fi

TARGET_DATE=""
if [ -n "$PARAM" ]; then
    TARGET_DATE=$(normalize_target_date "$PARAM")
fi

CLEAN_LINE=$(prepare_task_line "$LINE")

repeat_task "$ITEM" "$CLEAN_LINE" "$TARGET_DATE"

#
# @file overview (todo.sh action)
# @author Cody Sork <codysork@gmail.com> with help from AI agents
# @created 2026-11-22
# @modified 2026-11-23
# @description Display configured todo.sh views in one overview.
#
# Usage:
#   todo.sh overview

import os
import re
import shlex
import subprocess
import sys
from typing import NamedTuple

#-----------------------------------------------------------------------------#
#                               Constants                                     #
#-----------------------------------------------------------------------------#

DEFAULT_VIEWS = "today, routine, ls due, schedule"
TASK_ID_RE = re.compile(r"^\s*(\d+)\s+")
ANSI_RE = re.compile(r"\033\[[0-9;]*m")
TRUE_VALUES = {"1", "true", "yes", "on"}
FALSE_VALUES = {"0", "false", "no", "off"}

#-----------------------------------------------------------------------------#
#                               Functions                                     #
#-----------------------------------------------------------------------------#

def usage():
    """Print the overview action's indented help text."""
    print("  overview")
    print("    Display the configured todo.sh views and remaining tasks.")
    print("      Configure views with TODO_OVERVIEW_VIEWS.")
    print("      Examples:")
    print("        todo.sh overview")


def fail(message):
    """Report an overview error on stderr.

    @param message: error text to display.
    @return: exit status 1.
    """
    print(f"Overview: {message}", file=sys.stderr)
    return 1


def setting_enabled(name, default):
    """Interpret a boolean environment setting.

    @param name: environment variable name.
    @param default: value used when the variable is unset.
    @return: True or False for the configured value.
    @raises ValueError: when the value is not a recognized boolean.
    """
    value = os.environ.get(name, default).strip().lower()
    if value in TRUE_VALUES:
        return True
    if value in FALSE_VALUES:
        return False
    raise ValueError(f"{name} must be true or false, not {value!r}")


def parse_views(value):
    """Split the view setting into todo.sh commands.

    @param value: comma-separated view configuration.
    @return: list of argument lists.
    """
    views = []
    for item in value.split(","):
        command = shlex.split(item)
        if command:
            views.append(command)
    return views


class Settings(NamedTuple):
    """Parsed configuration for one overview run.

    @attribute views: todo.sh commands rendered as sections.
    @attribute show_remaining: whether to append a Remaining tasks section.
    @attribute allow_duplicates: whether task rows may repeat across views.
    @attribute todo_command: command used to invoke todo.sh.
    """
    views: list
    show_remaining: bool
    allow_duplicates: bool
    todo_command: list


# AI-generated code (unreviewed by a human)
def load_settings():
    # AI-generated documentation (not reviewed by a human)
    """Read and validate all overview environment settings.

    @return: Settings built from the environment.
    @raises ValueError: for an invalid boolean or an empty TODO_SH command.
    """
    views = parse_views(os.environ.get("TODO_OVERVIEW_VIEWS", DEFAULT_VIEWS))
    show_remaining = setting_enabled("TODO_OVERVIEW_SHOW_REMAINING_TASKS", "true")
    allow_duplicates = setting_enabled("TODO_OVERVIEW_DUPLICATE_TASKS", "false")
    todo_command = shlex.split(
        os.environ.get("TODO_FULL_SH")
        or os.environ.get("TODO_SH")
        or "todo.sh"
    )
    if not todo_command:
        raise ValueError("TODO_SH must name the todo.sh executable")
    return Settings(views, show_remaining, allow_duplicates, todo_command)


def task_id(line):
    """Extract the task number from one todo.sh output line.

    @param line: output line, possibly containing ANSI color codes.
    @return: task id string, or None when the line is not a task row.
    """
    plain = ANSI_RE.sub("", line)
    match = TASK_ID_RE.match(plain)
    return match.group(1) if match else None


def run_todo(todo_command, arguments):
    """Run one todo.sh command with verbose output disabled.

    @param todo_command: executable and leading arguments for todo.sh.
    @param arguments: subcommand and arguments to append.
    @return: captured stdout from the command.
    @raises RuntimeError: if the command cannot run or exits nonzero.
    """
    env = os.environ.copy()
    env["TODOTXT_VERBOSE"] = "0"
    try:
        result = subprocess.run(
            [*todo_command, *arguments],
            capture_output=True,
            text=True,
            env=env,
            check=False,
        )
    except OSError as error:
        raise RuntimeError(f"could not run todo.sh command: {error}") from error
    if result.returncode != 0:
        detail = result.stderr.strip() or f"exit status {result.returncode}"
        raise RuntimeError(
            f"todo.sh {' '.join(arguments)} failed: {detail}"
        )
    return result.stdout


def collect_outputs(settings):
    """Run the configured views and the optional list command.

    @param settings: overview configuration.
    @return: (view command/output pairs, remaining output or None).
    """
    outputs = [
        (command, run_todo(settings.todo_command, command))
        for command in settings.views
    ]
    remaining = (
        run_todo(settings.todo_command, ["list"])
        if settings.show_remaining
        else None
    )
    return outputs, remaining


def filter_view_output(output, seen, allow_duplicates):
    """Drop repeated task rows while keeping other output lines.

    @param output: stdout of one todo.sh view.
    @param seen: task ids already rendered in earlier views.
    @param allow_duplicates: keep repeated rows when True.
    @return: (rendered lines, new set of all seen task ids).
    """
    rendered = []
    updated_seen = set(seen)
    for line in output.splitlines():
        number = task_id(line)
        if number is None:
            rendered.append(line)
            continue
        already_seen = number in updated_seen
        updated_seen.add(number)
        if allow_duplicates or not already_seen:
            rendered.append(line)
    return rendered, updated_seen


def render_section(title, output, seen, allow_duplicates):
    """Print one titled section of overview output.

    @param title: section heading.
    @param output: stdout of the view being rendered.
    @param seen: task ids rendered so far.
    @param allow_duplicates: keep repeated rows when True.
    @return: new set of task ids seen after rendering this section.
    """
    print(f"=== {title} ===")
    lines, updated_seen = filter_view_output(output, seen, allow_duplicates)
    if lines:
        print("\n".join(lines))
    else:
        print("No tasks.")
    print()
    return updated_seen


def render_views(outputs, allow_duplicates):
    """Print every configured view in order.

    @param outputs: view command/output pairs.
    @param allow_duplicates: keep repeated rows when True.
    @return: set of task ids rendered across all views.
    """
    seen = set()
    for command, output in outputs:
        seen = render_section(" ".join(command), output, seen, allow_duplicates)
    return seen

def render_remaining(output, seen):
    """Print the Remaining tasks section after the views.

    @param output: stdout of the list command, or None when disabled.
    @param seen: task ids already rendered by the views.
    """
    print("=== Remaining tasks ===")
    lines, _ = filter_view_output(output or "", seen, False)
    if lines:
        print("\n".join(lines))
    else:
        print("No remaining tasks.")
    print()


def main():
    """Validate CLI arguments and render the overview report.

    @return: process exit status.
    """
    args = sys.argv[1:]
    if args and args[0] == os.path.basename(__file__):
        args = args[1:]
    if args and args[0].lower() in {"usage", "help", "-h", "--help"}:
        usage()
        return 0
    if args:
        return fail(f"unexpected arguments: {' '.join(args)}")

    try:
        settings = load_settings()
        outputs, remaining = collect_outputs(settings)
    except (ValueError, RuntimeError) as error:
        return fail(str(error))

    seen = render_views(outputs, settings.allow_duplicates)
    if settings.show_remaining:
        render_remaining(remaining, seen)
    return 0

if __name__ == "__main__":
    sys.exit(main())

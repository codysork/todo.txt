# AI-generated code (unreviewed by a human)
def bootstrap_days(daily, days, block_size, rng):
    """Sample daily sequences in contiguous blocks with replacement.

    Blocks wrap at the end of history so every historical day can start
    a block, including when shorter horizons use a longer path's prefix.
    """
    n = len(daily)
    remaining = days
    while remaining > 0:
        take = min(block_size, remaining)
        start = rng.randrange(n)
        for offset in range(take):
            yield daily[(start + offset) % n]
        remaining -= take


# AI-generated code (unreviewed by a human)
def simulate_probability(daily, days, pace, simulations, rng):
    """Return probability and MC error for meeting average pace over a period."""
    return simulate_probabilities(daily, (days,), pace, simulations, rng)[days]


# AI-generated code (unreviewed by a human)
def simulate_probabilities(daily, horizons, pace, simulations, rng):
    """Estimate average-pace probabilities on shared simulated paths."""
    horizons = sorted(set(horizons))
    block_size = min(BLOCK_DAYS, len(daily))
    successes = dict.fromkeys(horizons, 0)

    for _ in range(simulations):
        path = bootstrap_days(daily, horizons[-1], block_size, rng)
        total = 0.0
        for day, effort in enumerate(path, start=1):
            total += effort
            if day in successes and total >= pace * day:
                successes[day] += 1

    results = {}
    for days, count in successes.items():
        probability = count / simulations
        # Monte Carlo sampling error, not historical uncertainty.
        error = math.sqrt(probability * (1.0 - probability) / simulations)
        results[days] = probability, error
    return results



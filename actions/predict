#!/usr/bin/env python3
#
# @file predict (todo.sh action)
# @author Cody Sork <codysork@gmail.com> with help from AI agents
# @created 2026-11-21
# @modified 2026-11-21
# @description Estimate the probability (%) of maintaining a pace,
#              using historical daily effort and bootstrap simulation.
#
# Usage:
#   todo.sh predict pace [pace]
#
#   pace       target daily effort rate (default: historical mean)
#
# Model:
#   Moving-block bootstrap of historical daily effort.
#   Contiguous blocks preserve short-term patterns in productivity.
#
# Dependencies: Python standard library only.

import math
import os
import random
import re
import statistics
import sys
from datetime import date, timedelta
from typing import NamedTuple

#----------------------------------------------------------------------------
# Configuration
#----------------------------------------------------------------------------

DONE_FILE = os.environ.get("DONE_FILE") or os.path.join(
    os.environ.get("TODO_DIR") or os.path.expanduser("~"), "done.txt"
)

TODAY = date.today()

SIMULATIONS = 20_000
BLOCK_DAYS = 7

# Fixed seed ensures reproducible predictions.
RANDOM_SEED = 0

HELP_WORDS = ("usage", "help", "-h", "--help")

EFFORT_RE = re.compile(r"^effort:([0-9]+(?:\.[0-9]+)?)$")

#----------------------------------------------------------------------------
# Helpers
#----------------------------------------------------------------------------

def usage():
    print("  predict")
    print("    Estimate the probability of maintaining a pace.")
    print("      Modes:")
    print("        pace       predict maintainability")
    print("          pace     target daily effort (default: historical mean)")
    print("      Examples:")
    print("        todo.sh predict pace")
    print("        todo.sh predict pace 3.5")


def fail(message):
    print(f"Error: {message}", file=sys.stderr)
    sys.exit(1)


def month_length(today):
    first = date(today.year, today.month, 1)

    if today.month == 12:
        nxt = date(today.year + 1, 1, 1)
    else:
        nxt = date(today.year, today.month + 1, 1)

    return (nxt - first).days


def year_length(today):
    first = date(today.year, 1, 1)
    last = date(today.year + 1, 1, 1) - timedelta(days=1)

    return (last - first).days + 1


#----------------------------------------------------------------------------
# Data
#----------------------------------------------------------------------------

class History(NamedTuple):
    daily: list
    start: date
    total: float

    @property
    def span(self):
        return len(self.daily)

    @property
    def mean(self):
        return self.total / self.span

    @property
    def median(self):
        return statistics.median(self.daily)

    @property
    def stdev(self):
        return statistics.pstdev(self.daily)

    @property
    def zero_days(self):
        return sum(1 for effort in self.daily if effort == 0)

    @property
    def zero_frequency(self):
        return self.zero_days / self.span


def parse_done(path):
    """
    Read completed tasks and aggregate effort by calendar day.

    Only entries with valid effort metadata are included.
    Days without completed effort are represented as zero.
    The observation window extends through today, including
    recent inactivity.
    """

    if not os.path.isfile(path) or not os.access(path, os.R_OK):
        fail(f"Cannot read done file: {path}")

    daily = {}
    first = None

    try:
        with open(path, encoding="utf-8") as f:
            for line in f:
                fields = line.split()

                if len(fields) < 3 or fields[0] != "x":
                    continue

                try:
                    d = date.fromisoformat(fields[1])
                except ValueError:
                    continue

                # Future completions are not historical observations.
                if d > TODAY:
                    continue

                effort = None

                for tok in fields[2:]:
                    if tok.startswith("effort:"):
                        match = EFFORT_RE.fullmatch(tok)

                        if match:
                            value = float(match.group(1))

                            if math.isfinite(value):
                                effort = value

                        break

                # Ignore completions without valid effort metadata.
                if effort is None:
                    continue

                daily[d] = daily.get(d, 0.0) + effort

                first = d if first is None else min(first, d)

    except OSError as e:
        fail(f"Cannot read done file: {e}")

    if first is None:
        fail(f"No valid effort records found in done file: {path}")

    span = (TODAY - first).days + 1

    # Build a continuous daily time series.
    values = [
        daily.get(first + timedelta(days=i), 0.0)
        for i in range(span)
    ]

    total = math.fsum(values)

    return History(values, first, total)


#----------------------------------------------------------------------------
# Bootstrap prediction
#----------------------------------------------------------------------------

def bootstrap_sum(daily, days, block_size, rng):
    """
    Generate a simulated future effort total.

    Randomly samples contiguous historical blocks, preserving
    short-term patterns such as productive and unproductive
    stretches.

    Blocks are sampled with replacement.
    """

    n = len(daily)
    remaining = days
    total = 0.0

    while remaining > 0:
        take = min(block_size, remaining)

        # Select a valid contiguous block.
        start = rng.randrange(n - take + 1)

        total += math.fsum(daily[start:start + take])
        remaining -= take

    return total


def simulate_probability(daily, days, pace, simulations, rng):
    """
    Estimate the probability of achieving the target average
    daily effort over a future period.

    Returns:
        (probability, Monte Carlo standard error)
    """

    target = pace * days
    block_size = min(BLOCK_DAYS, len(daily))

    successes = 0

    for _ in range(simulations):
        effort = bootstrap_sum(
            daily,
            days,
            block_size,
            rng
        )

        if effort >= target:
            successes += 1

    probability = successes / simulations

    # Monte Carlo sampling error, not historical uncertainty.
    error = math.sqrt(
        probability * (1.0 - probability) / simulations
    )

    return probability, error


#----------------------------------------------------------------------------
# Reporting
#----------------------------------------------------------------------------

def print_report(history, pace):
    """
    Print historical statistics and simulated maintainability.
    """

    horizons = (
        ("Day", 1),
        ("Week", 7),
        ("Month", month_length(TODAY)),
        ("Year", year_length(TODAY)),
    )

    print("Pace Maintainability Report")
    print("=" * 65)
    print()
    print(f"Target pace:        {pace:.2f} effort/day")
    print(f"Historical average: {history.mean:.2f} effort/day")
    print(f"Historical median:  {history.median:.2f} effort/day")
    print(f"Daily deviation:    {history.stdev:.2f} effort/day")
    print(f"Zero-effort days:   {history.zero_frequency * 100:.1f}%")
    print(f"Historical days:    {history.span}")
    print(f"Simulations:        {SIMULATIONS:,}")
    print(f"Block size:         {min(BLOCK_DAYS, history.span)} days")
    print()

    print(f"{'Period':<9s} {'Target effort':>15s} "
          f"{'P(maintain)':>15s} {'MC error':>12s}")

    print("-" * 55)

    rng = random.Random(RANDOM_SEED)

    for name, days in horizons:
        target = pace * days

        probability, error = simulate_probability(
            history.daily,
            days,
            pace,
            SIMULATIONS,
            rng
        )

        print(
            f"{name:<9s} "
            f"{target:>15.2f} "
            f"{probability * 100:>14.1f}% "
            f"±{error * 100:>9.2f} pp"
        )

    print()
    print("Interpretation:")
    print("  Probability = chance of meeting or exceeding the")
    print("  target total effort over the specified period.")
    print()
    print("  MC error = Monte Carlo sampling error only.")
    print("  It does not represent uncertainty in future productivity.")


#----------------------------------------------------------------------------
# Modes
#----------------------------------------------------------------------------

def run_pace_mode(args, history):
    """Validate arguments and run pace prediction."""

    if len(args) > 1:
        fail("Too many arguments. Usage: predict pace [pace]")

    if not args:
        pace = history.mean
    else:
        try:
            pace = float(args[0])
        except ValueError:
            fail(f"Pace must be a number: {args[0]}")

        if not math.isfinite(pace) or pace <= 0:
            fail("Pace must be a finite number greater than zero.")

    print_report(history, pace)


#----------------------------------------------------------------------------
# Main
#----------------------------------------------------------------------------

def main():
    args = sys.argv[1:]

    # todo.sh passes the action name as the first argument.
    if args and args[0].lower() == "predict":
        args = args[1:]

    if args and args[0].lower() in HELP_WORDS:
        usage()
        return 0

    if not args:
        fail("Missing predict mode. Use 'predict pace [pace]'.")

    mode = args[0].lower()

    if mode != "pace":
        fail(f"Unknown predict mode '{args[0]}'.")

    args = args[1:]

    if args and args[0].lower() in HELP_WORDS:
        usage()
        return 0

    history = parse_done(DONE_FILE)

    run_pace_mode(args, history)

    return 0


if __name__ == "__main__":
    sys.exit(main())

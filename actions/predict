#!/usr/bin/env python3
#
# @file predict (todo.sh action)
# @author Cody Sork <codysork@gmail.com> with help from AI agents
# @created 2026-11-21
# @modified 2026-11-23
# @description Report historical statistics for one numeric task metadata key.
#
# Usage:
#   todo.sh predict KEY [value]
#
#   KEY        numeric key:value field to summarize (for example effort)
#   value      target daily average to check (default: historical mean)
#
# Dependencies: Python standard library only.

import math
import os
import random
import re
import statistics
import sys
from datetime import date, timedelta
from typing import NamedTuple

#----------------------------------------------------------------------------
# Configuration
#----------------------------------------------------------------------------

DONE_FILE = os.environ.get("DONE_FILE") or os.path.join(
    os.environ.get("TODO_DIR") or os.path.expanduser("~"), "done.txt"
)

TODAY = date.today()

SIMULATIONS = 20_000
BLOCK_DAYS = 7
RANDOM_SEED = 0

HELP_WORDS = ("usage", "help", "-h", "--help")

METADATA_KEY_RE = re.compile(r"^[A-Za-z][A-Za-z0-9_-]*$")
NUMBER_RE = re.compile(
    r"^[+-]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
)
NUMERIC_LIKE_RE = re.compile(r"^[+\-.0-9]")
DATE_VALUE_RE = re.compile(r"^[0-9]{4}-[0-9]{2}-[0-9]{2}$")

#----------------------------------------------------------------------------
# Helpers
#----------------------------------------------------------------------------

def usage():
    print("  predict")
    print("    Report historical statistics for one numeric task metadata key.")
    print("      KEY        key to summarize, such as effort or physical-exertion")
    print("      value      target daily average (default: historical mean)")
    print("      Examples:")
    print("        todo.sh predict effort")
    print("        todo.sh predict effort 3.5")
    print("        todo.sh predict physical-exertion 3.0")

def fail(message):
    print(f"Error: {message}", file=sys.stderr)
    sys.exit(1)

def month_length(today):
    first = date(today.year, today.month, 1)

    if today.month == 12:
        nxt = date(today.year + 1, 1, 1)
    else:
        nxt = date(today.year, today.month + 1, 1)

    return (nxt - first).days

def year_length(today):
    first = date(today.year, 1, 1)
    last = date(today.year + 1, 1, 1) - timedelta(days=1)

    return (last - first).days + 1

#----------------------------------------------------------------------------
# Data
#----------------------------------------------------------------------------

class History(NamedTuple):
    daily: list
    start: date
    total: float
    key: str

    @property
    def span(self):
        return len(self.daily)

    @property
    def mean(self):
        return self.total / self.span

    @property
    def median(self):
        return statistics.median(self.daily)

    @property
    def stdev(self):
        return statistics.pstdev(self.daily)

    @property
    def zero_days(self):
        return sum(1 for value in self.daily if value == 0)

    @property
    def zero_frequency(self):
        return self.zero_days / self.span

def parse_done(path, key):
    """Parse one numeric metadata key and aggregate it by completion date."""
    if not METADATA_KEY_RE.fullmatch(key):
        fail(f"Invalid metadata key: {key}")
    if not os.path.isfile(path) or not os.access(path, os.R_OK):
        fail(f"Cannot read done file: {path}")

    daily = read_daily_values(path, key)
    if not daily:
        fail(f"No data for key '{key}' in done file: {path}")

    values = [daily[completed] for completed in sorted(daily)]
    return History(values, min(daily), math.fsum(values), key)

def read_daily_values(path, key):
    """Return validated key values aggregated by completion date."""
    daily = {}
    try:
        with open(path, encoding="utf-8") as f:
            for line_number, line in enumerate(f, start=1):
                fields = line.split()
                completed = completion_date(fields)
                if completed is None:
                    continue

                raw_value = find_key_value(fields, key, line_number, path)
                if raw_value is None:
                    continue

                value = parse_number(raw_value, key, line_number)
                if value is None:
                    continue

                daily[completed] = daily.get(completed, 0.0) + value
    except OSError as error:
        fail(f"Cannot read done file: {error}")
    return daily

def completion_date(fields):
    """Return a record's completion date, or None when it is unusable."""
    if len(fields) < 3 or fields[0] != "x":
        return None
    try:
        completed = date.fromisoformat(fields[1])
    except ValueError:
        return None
    return completed if completed <= TODAY else None

def find_key_value(fields, key, line_number, path):
    """Return a key's raw value, rejecting a repeated key on one record."""
    values = [
        token.partition(":")[2]
        for token in fields[2:]
        if token.partition(":")[0] == key and ":" in token
    ]
    if len(values) > 1:
        fail(
            f"Duplicate key '{key}' on line {line_number} "
            f"in done file: {path}"
        )
    return values[0] if values else None

def parse_number(raw_value, key, line_number):
    """Return a validated number, or None when the value is not numeric."""
    if DATE_VALUE_RE.fullmatch(raw_value):
        return None
    try:
        value = float(raw_value)
    except ValueError:
        if not raw_value or NUMERIC_LIKE_RE.match(raw_value):
            fail(
                f"Malformed numeric value for key '{key}' "
                f"on line {line_number}: {raw_value!r}"
            )
        return None

    if math.isnan(value):
        fail(f"NaN value for key '{key}' on line {line_number}.")
    if math.isinf(value):
        fail(f"Infinite value for key '{key}' on line {line_number}.")
    if not NUMBER_RE.fullmatch(raw_value):
        fail(
            f"Malformed numeric value for key '{key}' "
            f"on line {line_number}: {raw_value!r}"
        )
    return value

#----------------------------------------------------------------------------
# Bootstrap prediction
#----------------------------------------------------------------------------

def bootstrap_days(daily, days, block_size, rng):
    """Sample daily sequences in contiguous blocks with replacement.

    Blocks wrap at the end of history so every historical day can start
    a block, including when shorter horizons use a longer path's prefix.
    """
    n = len(daily)
    remaining = days
    while remaining > 0:
        take = min(block_size, remaining)
        start = rng.randrange(n)
        for offset in range(take):
            yield daily[(start + offset) % n]
        remaining -= take

def simulate_probabilities(daily, horizons, pace, simulations, rng):
    """Estimate average-pace probabilities on shared simulated paths."""
    horizons = sorted(set(horizons))
    block_size = min(BLOCK_DAYS, len(daily))
    successes = dict.fromkeys(horizons, 0)

    for _ in range(simulations):
        one_sim_future_set = bootstrap_days(daily, horizons[-1], block_size, rng)
        total = 0.0
        for day, value in enumerate(one_sim_future_set, start=1):
            total += value
            if day in successes and total >= pace * day:
                successes[day] += 1

    results = {}
    for days, count in successes.items():
        probability = count / simulations
        # Monte Carlo sampling error, not historical uncertainty.
        error = math.sqrt(probability * (1.0 - probability) / simulations)
        results[days] = probability, error
    return results


#----------------------------------------------------------------------------
# Reporting
#----------------------------------------------------------------------------

def print_report(history, pace):
    """
    Print historical statistics and simulated maintainability.
    """

    horizons = (
        ("Day", 1),
        ("Week", 7),
        ("Month", month_length(TODAY)),
        ("Year", year_length(TODAY)),
    )

    print("Pace Maintainability Report")
    print("=" * 65)
    print()
    print(f"Selected key:       {history.key}")
    print(f"Target pace:        {pace:.2f} {history.key}/day")
    print(f"Historical average: {history.mean:.2f} {history.key}/day")
    print(f"Historical median:  {history.median:.2f} {history.key}/day")
    print(f"Daily deviation:    {history.stdev:.2f} {history.key}/day")
    print(f"Zero-value frequency: {history.zero_frequency * 100:5.1f}%")
    print(f"Observation days:   {history.span}")
    print(f"Simulations:        {SIMULATIONS:,}")
    print(f"Block size:         {min(BLOCK_DAYS, history.span)} days")
    print()

    print(f"{'Period':<9s} {'Target effort':>15s} "
          f"{'P(maintain)':>15s} {'MC error':>12s}")

    print("-" * 55)

    rng = random.Random(RANDOM_SEED)
    predictions = simulate_probabilities(
        history.daily, [days for _, days in horizons], pace, SIMULATIONS, rng
    )

    for name, days in horizons:
        probability, error = predictions[days]
        target = pace * days

        print(
            f"{name:<9s} "
            f"{target:>15.2f} "
            f"{probability * 100:>14.1f}% "
            f"±{error * 100:>9.2f} pp"
        )

    print()
    print("Interpretation:")
    print("  Probability = chance of meeting or exceeding target")
    print("  total effort (target pace × calendar days) over the period.")
    print("  Extra effort can compensate for a lower-effort day.")
    print()
    print("  MC error = Monte Carlo sampling error only.")
    print("  It does not represent uncertainty in future productivity.")


#----------------------------------------------------------------------------
# Modes
#----------------------------------------------------------------------------

def parse_target(value):
    """Validate an optional target pace for the selected key."""
    try:
        target = float(value)
    except ValueError:
        fail(f"Target must be a number: {value}")
    if math.isnan(target):
        fail(f"Target must be a finite number: {value}")
    if math.isinf(target):
        fail(f"Target must be finite: {value}")
    return target

def run_key_statistics(args):
    """Load a key, then report its statistics and optional target pace."""
    if len(args) > 2:
        fail("Usage: todo.sh predict KEY [value] (too many arguments).")

    key = args[0]
    if not METADATA_KEY_RE.fullmatch(key):
        fail(f"Invalid metadata key: {key}")

    history = parse_done(DONE_FILE, key)
    target = parse_target(args[1]) if len(args) == 2 else history.mean
    print_report(history, target)

#----------------------------------------------------------------------------
# Main
#----------------------------------------------------------------------------

def main():
    args = sys.argv[1:]

    # todo.sh passes the action name as the first argument.
    if args and args[0].lower() == "predict":
        args = args[1:]

    if args and args[0].lower() in HELP_WORDS:
        usage()
        return 0

    if not args:
        fail("Usage: todo.sh predict KEY (name one numeric metadata key).")

    run_key_statistics(args)
    return 0

if __name__ == "__main__":
    sys.exit(main())

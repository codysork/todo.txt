#!/usr/bin/env python3
#
# @file predict (todo.sh action)
# @author Cody Sork <codysork@gmail.com> with help from AI agents
# @created 2026-11-21
# @modified 2026-11-21
# @description Print the probability (%) of keeping a pace, from done.txt history.
#
# Usage:
#   todo.sh predict pace [pace]
#
#   pace       target daily effort rate (default: posterior mean rate)

import math
import os
import re
import sys
from datetime import date, timedelta
from typing import NamedTuple

#----------------------------------------------------------------------------
# Configuration
#----------------------------------------------------------------------------

DONE_FILE = os.environ.get("DONE_FILE") or os.path.join(
    os.environ.get("TODO_DIR") or os.path.expanduser("~"), "done.txt"
)
TODAY = date.today()

# Conjugate prior on the daily effort rate: lambda ~ Gamma(alpha, beta).
PRIOR_ALPHA = 1.0
PRIOR_BETA = 1.0

HELP_WORDS = ("usage", "help", "-h", "--help")

#----------------------------------------------------------------------------
# Helpers
#----------------------------------------------------------------------------

def usage():
    print("  predict")
    print("    Print the probability (%) of keeping a pace, from done.txt history.")
    print("      Modes:")
    print("        pace       maintainability report for a target daily pace")
    print("          pace     target rate (default: posterior mean rate)")
    print("      Examples:")
    print("        todo.sh predict pace")
    print("        todo.sh predict pace 3.5")


def fail(message):
    print(f"Error: {message}", file=sys.stderr)
    sys.exit(1)


def month_length(today):
    first = date(today.year, today.month, 1)
    if today.month == 12:
        nxt = date(today.year + 1, 1, 1)
    else:
        nxt = date(today.year, today.month + 1, 1)
    last = nxt - timedelta(days=1)
    return (last - first).days + 1


def year_length(today):
    first = date(today.year, 1, 1)
    last = date(today.year + 1, 1, 1) - timedelta(days=1)
    return (last - first).days + 1

#----------------------------------------------------------------------------
# Data (from $DONE_FILE, parsed like `pace`)
#----------------------------------------------------------------------------

class History(NamedTuple):
    total: float
    span: int
    min_effort: float


def parse_done(path):
    """Return the effort total, day span, and minimum effort from `path`."""
    effort_re = re.compile(r"^effort:([0-9]+(?:\.[0-9]+)?)$")
    if not os.path.isfile(path) or not os.access(path, os.R_OK):
        fail(f"Cannot read done file: {path}")
    total = 0.0
    efforts = []
    first = None
    last = None
    with open(path, encoding="utf-8") as f:
        for line in f:
            fields = line.split()
            if len(fields) < 2 or fields[0] != "x":
                continue
            try:
                d = date.fromisoformat(fields[1])
            except ValueError:
                continue
            for tok in fields[2:]:
                m = effort_re.match(tok)
                if m:
                    effort = float(m.group(1))
                    total += effort
                    efforts.append(effort)
                    break
            first = d if first is None else min(first, d)
            last = d if last is None else max(last, d)
    if first is None:
        fail(f"No completions found in done file: {path}")
    min_effort = min(efforts) if efforts else 0.0
    return History(total, (last - first).days + 1, min_effort)

#----------------------------------------------------------------------------
# Bayesian model (conjugate Gamma-Poisson)
#----------------------------------------------------------------------------

def posterior(total, span):
    """Posterior Gamma of the daily effort rate.

    Likelihood: daily effort E ~ Poisson(lambda); prior lambda ~ Gamma(a, b).
    Posterior: lambda | data ~ Gamma(a + sum(E), b + span_days).
    """
    alpha = PRIOR_ALPHA + total
    beta = PRIOR_BETA + span
    return alpha, beta


def maintained_prob(alpha, beta, days, pace, min_effort):
    """Probability that the realized effort over `days` meets the target pace.

    A pace at or below the smallest effort on record is fully maintainable.
    Above it, realized effort is assumed to be at least the minimum, with
    deviations spread by the Poisson-Gamma predictive standard deviation;
    the half-normal survival makes P start at 100% at the minimum and fall
    smoothly toward zero as the target rises.
    """
    if pace <= min_effort:
        return 1.0
    mu = days * alpha / beta
    sd = math.sqrt(mu + days * days * alpha / (beta * beta))
    excess = (pace - min_effort) * days
    return math.erfc(excess / (sd * math.sqrt(2)))

#----------------------------------------------------------------------------
# Reporting
#----------------------------------------------------------------------------

def print_report(alpha, beta, pace, min_effort):
    lam = alpha / beta
    horizons = (
        ("Day", 1),
        ("Week", 7),
        ("Month", month_length(TODAY)),
        ("Year", year_length(TODAY)),
    )
    print(f"Target pace:    {pace:.2f} effort/day")
    print(f"Posterior rate: {lam:.3f} effort/day (alpha={alpha:.2f}, beta={beta:.2f})")
    print()
    print(f"{'Period':<8s} {'Target velocity':>16s} {'P(maintain)':>14s}")
    print(f"{'--------':<8s} {'----------------':>16s} {'--------------':>14s}")
    for name, days in horizons:
        target = pace * days
        p = maintained_prob(alpha, beta, days, pace, min_effort)
        print(f"{name:<8s} {target:>16.2f} {p * 100:>13.1f}%")

#----------------------------------------------------------------------------
# Modes
#----------------------------------------------------------------------------

def run_pace_mode(args, alpha, beta, lam, min_effort):
    """Validate pace-mode arguments and print the Bayesian pace report."""
    pace_arg = args[0] if len(args) >= 1 else None

    if pace_arg is None:
        pace = lam
    else:
        try:
            pace = float(pace_arg)
        except ValueError:
            fail(f"Pace must be a number: {pace_arg}")
        if not (pace > 0):
            fail("Pace must be > 0.")
        if not math.isfinite(pace):
            fail("Pace must be finite.")

    print_report(alpha, beta, pace, min_effort)

#----------------------------------------------------------------------------
# Main
#----------------------------------------------------------------------------

def main():
    args = sys.argv[1:]

    if args and args[0].lower() in HELP_WORDS:
        usage()
        return 0

    # todo.sh passes the action name as the first argument; `todo.sh help`
    # and `todo.sh shorthelp` pass `usage` as the only argument.
    if args and args[0].lower() == "predict":
        args = args[1:]
    if args and args[0].lower() in HELP_WORDS:
        usage()
        return 0

    if not args:
        fail("Missing predict mode. Use 'predict pace [pace]'.")
    mode = args[0].lower()
    if mode != "pace":
        fail(f"Unknown predict mode '{args[0]}'.")
    args = args[1:]
    if args and args[0].lower() in HELP_WORDS:
        usage()
        return 0

    history = parse_done(DONE_FILE)
    alpha, beta = posterior(history.total, history.span)
    lam = alpha / beta

    run_pace_mode(args, alpha, beta, lam, history.min_effort)
    return 0


if __name__ == "__main__":
    sys.exit(main())

# AI-generated code (unreviewed by a human)
def parse_done(path, key="effort"):
    """Parse one numeric metadata key and aggregate it by completion date."""
    if not METADATA_KEY_RE.fullmatch(key):
        fail(f"Invalid metadata key: {key}")
    if not os.path.isfile(path) or not os.access(path, os.R_OK):
        fail(f"Cannot read done file: {path}")

    daily = {}
    first = None

    try:
        with open(path, encoding="utf-8") as f:
            for line_number, line in enumerate(f, start=1):
                fields = line.split()
                if len(fields) < 3 or fields[0] != "x":
                    continue

                try:
                    completed = date.fromisoformat(fields[1])
                except ValueError:
                    continue
                if completed > TODAY:
                    continue

                values = [
                    token.partition(":")[2]
                    for token in fields[2:]
                    if token.partition(":")[0] == key and ":" in token
                ]
                if len(values) > 1:
                    fail(
                        f"Duplicate key '{key}' on line {line_number} "
                        f"in done file: {path}"
                    )
                if not values:
                    continue

                raw_value = values[0]
                if DATE_VALUE_RE.fullmatch(raw_value):
                    continue
                try:
                    value = float(raw_value)
                except ValueError:
                    if not raw_value or NUMERIC_LIKE_RE.match(raw_value):
                        fail(
                            f"Malformed numeric value for key '{key}' "
                            f"on line {line_number}: {raw_value!r}"
                        )
                    continue

                if math.isnan(value):
                    fail(f"NaN value for key '{key}' on line {line_number}.")
                if math.isinf(value):
                    fail(f"Infinite value for key '{key}' on line {line_number}.")
                if not NUMBER_RE.fullmatch(raw_value):
                    fail(
                        f"Malformed numeric value for key '{key}' "
                        f"on line {line_number}: {raw_value!r}"
                    )

                daily[completed] = daily.get(completed, 0.0) + value
                first = completed if first is None else min(first, completed)
    except OSError as error:
        fail(f"Cannot read done file: {error}")

    if first is None:
        if key == "effort":
            fail(f"No valid effort records found in done file: {path}")
        fail(f"No data for key '{key}' in done file: {path}")

    values = [daily[completed] for completed in sorted(daily)]
    return History(values, first, math.fsum(values), key)


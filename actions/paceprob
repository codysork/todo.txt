#!/usr/bin/env python3
#
# @file paceprob (todo.sh action)
# @author Cody Sork <codysork@gmail.com> with help from AI agents
# @created 2026-11-21
# @modified 2026-11-21
# @description Print the probability (%) of keeping a pace, from done.txt history.
#
# Usage:
#   todo.sh paceprob [pace] [tolerance]
#
#   pace       target daily effort rate (default: posterior mean rate)
#   tolerance  relative band, default 0.20

import math
import os
import re
import sys
from datetime import date, timedelta

#----------------------------------------------------------------------------
# Configuration
#----------------------------------------------------------------------------

DONE_FILE = os.environ.get("DONE_FILE") or os.path.join(
    os.environ.get("TODO_DIR") or os.path.expanduser("~"), "done.txt"
)
TODAY = date.today()

# Conjugate prior on the daily effort rate: lambda ~ Gamma(alpha, beta).
PRIOR_ALPHA = 1.0
PRIOR_BETA = 1.0

# Default relative band around the target:
# [pace * d * (1 - tol), pace * d * (1 + tol)].
DEFAULT_TOL = 0.20

HELP_WORDS = ("usage", "help", "-h", "--help")

#----------------------------------------------------------------------------
# Helpers
#----------------------------------------------------------------------------

def usage():
    print("  paceprob")
    print("    Print the probability (%) of keeping a pace, from done.txt history.")
    print("      pace       target daily effort rate (default: posterior mean rate)")
    print("      tolerance  relative band, default 0.20")
    print("      Examples:")
    print("        todo.sh paceprob")
    print("        todo.sh paceprob 3.5")
    print("        todo.sh paceprob 3.5 0.15")


def fail(message):
    print(f"Error: {message}", file=sys.stderr)
    sys.exit(1)


def month_length(today):
    first = date(today.year, today.month, 1)
    if today.month == 12:
        nxt = date(today.year + 1, 1, 1)
    else:
        nxt = date(today.year, today.month + 1, 1)
    last = nxt - timedelta(days=1)
    return (last - first).days + 1


def year_length(today):
    first = date(today.year, 1, 1)
    last = date(today.year + 1, 1, 1) - timedelta(days=1)
    return (last - first).days + 1

#----------------------------------------------------------------------------
# Data (from $DONE_FILE, parsed like `pace`)
#----------------------------------------------------------------------------

def parse_done(path):
    """Return (sum of effort values, span of completed days) from `path`."""
    effort_re = re.compile(r"^effort:([0-9]+(?:\.[0-9]+)?)$")
    if not os.path.isfile(path) or not os.access(path, os.R_OK):
        fail(f"Cannot read done file: {path}")
    total = 0.0
    first = None
    last = None
    with open(path, encoding="utf-8") as f:
        for line in f:
            fields = line.split()
            if len(fields) < 2 or fields[0] != "x":
                continue
            try:
                d = date.fromisoformat(fields[1])
            except ValueError:
                continue
            for tok in fields[2:]:
                m = effort_re.match(tok)
                if m:
                    total += float(m.group(1))
                    break
            first = d if first is None else min(first, d)
            last = d if last is None else max(last, d)
    if first is None:
        fail(f"No completions found in done file: {path}")
    return total, (last - first).days + 1

#----------------------------------------------------------------------------
# Bayesian model (conjugate Gamma-Poisson)
#----------------------------------------------------------------------------

def posterior(total, span):
    """Posterior Gamma of the daily effort rate.

    Likelihood: daily effort E ~ Poisson(lambda); prior lambda ~ Gamma(a, b).
    Posterior: lambda | data ~ Gamma(a + sum(E), b + span_days).
    """
    alpha = PRIOR_ALPHA + total
    beta = PRIOR_BETA + span
    return alpha, beta


def maintained_prob(alpha, beta, days, pace):
    """Probability that the realized effort over `days` meets the target pace.

    The realized effort is modeled as normal with
        mean = days * alpha / beta           (posterior mean daily rate x days)
        sd   = sqrt(days * alpha / beta + days**2 * alpha / beta**2)
    (the variance of the negative-binomial marginal of the Poisson-Gamma
    model).  Maintaining a pace of `pace` means realizing at least the
    target; with a lower target the event is easier, so the probability
    grows as the pace drops.  A target of 0 or less is met for sure.
    """
    target = pace * days
    if target <= 0:
        return 1.0
    mu = days * alpha / beta
    sd = math.sqrt(days * alpha / beta + days * days * alpha / (beta * beta))
    z = (mu - target) / sd
    return 0.5 * math.erfc(-z / math.sqrt(2))

#----------------------------------------------------------------------------
# Reporting
#----------------------------------------------------------------------------

def print_report(alpha, beta, pace, tol):
    lam = alpha / beta
    horizons = (
        ("Day", 1),
        ("Week", 7),
        ("Month", month_length(TODAY)),
        ("Year", year_length(TODAY)),
    )
    print(f"Target pace:    {pace:.2f} effort/day (tolerance {tol * 100:.0f}%)")
    print(f"Posterior rate: {lam:.3f} effort/day (alpha={alpha:.2f}, beta={beta:.2f})")
    print()
    print(f"{'Period':<8s} {'Target velocity':>16s} {'P(maintain)':>14s}")
    print(f"{'--------':<8s} {'----------------':>16s} {'--------------':>14s}")
    for name, days in horizons:
        target = pace * days
        p = maintained_prob(alpha, beta, days, pace)
        print(f"{name:<8s} {target:>16.2f} {p * 100:>13.1f}%")

#----------------------------------------------------------------------------
# Main
#----------------------------------------------------------------------------

def main():
    args = sys.argv[1:]

    if args and args[0].lower() in HELP_WORDS:
        usage()
        return 0

    # todo.sh passes the action name as the first argument; `todo.sh help`
    # and `todo.sh shorthelp` pass `usage` as the only argument.
    if args and args[0].lower() == "paceprob":
        args = args[1:]
    if args and args[0].lower() in HELP_WORDS:
        usage()
        return 0

    total, span = parse_done(DONE_FILE)
    alpha, beta = posterior(total, span)
    lam = alpha / beta

    pace_arg = args[0] if len(args) >= 1 else None
    tol_arg = args[1] if len(args) >= 2 else None

    if tol_arg is None:
        tol = DEFAULT_TOL
    else:
        try:
            tol = float(tol_arg)
        except ValueError:
            fail(f"Tolerance must be a number: {tol_arg}")
        if not (tol > 0):
            fail("Tolerance must be > 0.")
        if not math.isfinite(tol):
            fail("Tolerance must be finite.")

    if pace_arg is None:
        pace = lam
    else:
        try:
            pace = float(pace_arg)
        except ValueError:
            fail(f"Pace must be a number: {pace_arg}")
        if not (pace > 0):
            fail("Pace must be > 0.")
        if not math.isfinite(pace):
            fail("Pace must be finite.")

    print_report(alpha, beta, pace, tol)
    return 0


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env bash
# @author Cody Sork <codysork@gmail.com>
# @created ?
# @modified 2026-11-22

action=$1
shift
item=$1
shift
param="$*"

TODO_CMD="${TODO_FULL_SH:-${TODO_SH:-todo.sh}}"
TODO_FILE="${TODO_FILE:-${TODO_DIR:-$HOME}/todo.txt}"

pattern=" t:\([0-9]\{2,4\}[^A-Za-z0-9]\)\{2\}[0-9]\{2,4\}" # not enforcing any particular format
TASK_IDS=()

function usage {
	echo "  $(basename $0) [<item|item-list|item-range> <date>|<priority> <date>|<item> mv <date>|<item> rm]"
	echo "    Set, modify or remove date threshold of an item, or schedule"
	echo "    tasks selected by number, number list, number range, or priority."
	echo "    If arguments are omitted, all scheduled tasks are listed."
	echo "    Intended for use with futureTasks \
(http://github.com/FND/todo.txt-cli/blob/extensions/futureTasks)."
	echo "    Examples:"
	echo "      $ $TODO_SH $(basename $0) 42 tomorrow"
	echo "      $ $TODO_SH $(basename $0) 71-75 tomorrow"
	echo "      $ $TODO_SH $(basename $0) 2,5,9 monday"
	echo "      $ $TODO_SH $(basename $0) 2,5-7,9 \"next monday\""
	echo "      $ $TODO_SH $(basename $0) 42 mv 7 days"
	echo "      $ $TODO_SH $(basename $0) 42 rm"
	echo "      $ $TODO_SH $(basename $0) R tomorrow"
	echo ""
	exit
}

function list {
	"$TODO_CMD" -x list | grep "$pattern"
}

function add {
	local item=$1
	local threshold=$2

	local flag
	flag=$(sed -e "$item!d" "$TODO_FILE" | grep "$pattern")

	if [ -z "$flag" ]; then
		"$TODO_CMD" append "$item" "t:$(date -d "$threshold" +%F)"
	else
		replace "$item" "$threshold"
	fi
}

function remove {
	local item=$1
	local task=`sed -e "$item!d" \
			-e "s/^[0-9]* //" \
			-e "s/^([A-Za-z])* //" \
			-e "s/$pattern//" \
			"$TODO_FILE"` # remove item number, priority and threshold
	"$TODO_CMD" replace "$item" "$task" # NB: retains priority
}

function replace {
	local item=$1
	local threshold=$2
	remove "$item"
	add "$item" "$threshold"
}

function validate_date {
	local target_date=$1
	[[ "$target_date" == mv* ]] && target_date="${target_date#mv }"

	if ! date -d "$target_date" +%F >/dev/null 2>&1; then
		date -d "$target_date" +%F
		exit 1
	fi
}

function confirm {
	local message=$1
	local answer
	read -r -p "$message (y/N) " answer || answer=
	case "$answer" in
		y|Y|yes|YES|Yes) return 0 ;;
		*) return 1 ;;
	esac
}

function apply_schedule {
	local item=$1
	local param=$2

	if [ "$param" = "rm" ]; then
		remove "$item"
	elif [[ "$param" == mv* ]]; then # XXX: obsolete
		local threshold=${param#mv }
		replace "$item" "$threshold"
	else
		add "$item" "$param"
	fi
}

function get_tasks_by_priority {
	local pri=$1
	sed -n -E "/^[[:space:]]*\([${pri}${pri,,}]\)( |$)/=" "$TODO_FILE"
}

function schedule_priority {
	local pri=$1
	local param=$2
	local verb="Reschedule"

	[ -z "$param" ] && usage

	if [ "$param" != "rm" ]; then
		validate_date "$param"
	else
		verb="Remove schedule from"
	fi

	local tasks
	tasks=$(get_tasks_by_priority "$pri")
	if [ -z "$tasks" ]; then
		echo "TODO: No tasks with priority ($pri)."
		return 0
	fi

	for it in $tasks; do
		local task
		task=$(sed -n "${it}p" "$TODO_FILE")
		printf '%s %s\n' "$it" "$task"
		if confirm "$verb task $it?"; then
			apply_schedule "$it" "$param"
		fi
	done
}

function schedule_item {
	local item=$1
	local param=$2

	if [ "$param" != "rm" ]; then
		validate_date "$param"
	fi

	apply_schedule "$item" "$param"
}

function normalize_task_number {
	local number=$1
	local task_count=$2

	[[ "$number" =~ ^[0-9]+$ ]] || return 1
	while [[ ${#number} -gt 1 && "$number" == 0* ]]; do
		number=${number#0}
	done

	if [[ "$number" == "0" ]] ||
		(( ${#number} > ${#task_count} )) ||
		{ (( ${#number} == ${#task_count} )) && (( 10#$number > 10#$task_count )); }; then
		return 1
	fi

	printf '%s' "$number"
}

function parse_task_selection {
	local selection=$1
	local task_count=$2
	local part start end number normalized
	local -a parts=()

	TASK_IDS=()
	[[ "$selection" =~ ^[0-9]+(-[0-9]+)?(,[0-9]+(-[0-9]+)?)*$ ]] ||
		return 1
	IFS=',' read -r -a parts <<< "$selection"

	for part in "${parts[@]}"; do
		if [[ "$part" == *-* ]]; then
			start=${part%%-*}
			end=${part#*-}
		else
			start=$part
			end=$part
		fi

		start=$(normalize_task_number "$start" "$task_count") || return 1
		end=$(normalize_task_number "$end" "$task_count") || return 1
		(( 10#$start <= 10#$end )) || return 1

		for ((number = 10#$start; number <= 10#$end; number++)); do
			normalized=$(normalize_task_number "$number" "$task_count") ||
				return 1
			if [[ ! " ${TASK_IDS[*]} " =~ [[:space:]]${normalized}[[:space:]] ]]; then
				TASK_IDS+=("$normalized")
			fi
		done
	done
}

function schedule_items {
	local selection=$1
	local param=$2
	local task_count
	local item

	[[ -r "$TODO_FILE" ]] || {
		echo "Schedule: cannot read todo file: $TODO_FILE" >&2
		exit 1
	}
	task_count=$(awk 'END { print NR }' "$TODO_FILE")
	parse_task_selection "$selection" "$task_count" || {
		echo "Schedule: invalid task selection '$selection'." >&2
		exit 1
	}

	if [ "$param" != "rm" ]; then
		validate_date "$param"
	fi

	# Validate every selected line before changing any task.
	for item in "${TASK_IDS[@]}"; do
		if [ -z "$(sed -n "${item}p" "$TODO_FILE")" ]; then
			echo "Schedule: no task numbered $item." >&2
			exit 1
		fi
	done

	for item in "${TASK_IDS[@]}"; do
		apply_schedule "$item" "$param"
	done
}

[ "$action" = "usage" ] && usage

if [ -z "$item" ]; then
	list
elif [[ "$item" =~ ^\(?([A-Za-z])\)?$ ]]; then
	schedule_priority "${BASH_REMATCH[1]^^}" "$param"
elif [[ "$item" =~ ^[0-9] || "$item" == *,* || "$item" == *-* ]]; then
	schedule_items "$item" "$param"
else
	schedule_item "$item" "$param"
fi
